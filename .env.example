DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# 플랫폼 JWT 시크릿 (에이전트 인증용)
# 생성 방법: openssl rand -base64 32
PAPERCLIP_AGENT_JWT_SECRET=YOUR_JWT_SECRET_HERE

# 금융 데이터 API 키 (자세한 발급 방법은 INFRA.example.md 참고)
# DART: https://opendart.fss.or.kr/
DART_API_KEY=YOUR_DART_API_KEY
# ECOS: https://ecos.bok.or.kr/
ECOS_API_KEY=YOUR_ECOS_API_KEY
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=YOUR_FRED_API_KEY

# 하트비트 스케줄러 (개발 중에는 false 권장)
HEARTBEAT_SCHEDULER_ENABLED=false

# SR Research Centre 회사 ID (플랫폼 최초 실행 시 자동 생성됨)
# pnpm dev 이후 http://127.0.0.1:3100/api/companies 에서 확인
SR_COMPANY_ID=YOUR_COMPANY_ID
